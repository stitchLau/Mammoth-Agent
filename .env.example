# Mammoth local development environment (copy to .env and adjust; never commit real secrets)
#
# Backend (services/domain)
MAMMOTH_SERVER_PORT=8080
# Leave empty to use the OS application-data default (%LOCALAPPDATA%\Mammoth\data on Windows).
# Must NOT be inside the source checkout or the DSH home (~/.dsh).
MAMMOTH_DATA_ROOT=

# Web UI (apps/web)
VITE_API_BASE_URL=http://127.0.0.1:8080
