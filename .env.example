# Mammoth local development environment (copy to .env and adjust; never commit real secrets)
#
# Backend (services/domain)
MAMMOTH_SERVER_PORT=8080
# Leave empty to use the OS application-data default (%LOCALAPPDATA%\Mammoth\data on Windows).
# Must NOT be inside the source checkout, the DSH home (~/.dsh), a network path or a cloud-synced
# directory (ADR-0008); SQLite WAL is unsafe on those filesystems.
MAMMOTH_DATA_ROOT=
# ADR-0008 safety overrides — keep false unless a controlled test/migration requires it.
# MAMMOTH_DATA_ROOT_READ_ONLY is normally forced by the MCP entrypoint; set it only for diagnostics.
MAMMOTH_DATA_ROOT_READ_ONLY=false
MAMMOTH_ALLOW_UNSUPPORTED_ROOT=false

# Web UI (apps/web)
VITE_API_BASE_URL=http://127.0.0.1:8080
